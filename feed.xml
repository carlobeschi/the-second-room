---
layout: null
permalink: /feed.xml
---
<?xml version="1.0" encoding="utf-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
<channel>
  <title>{{ site.title | xml_escape }}</title>
  <link>{{ '/' | absolute_url }}</link>
  <atom:link href="{{ '/feed.xml' | absolute_url }}" rel="self" type="application/rss+xml"/>
  <description>{{ site.description | strip_newlines | xml_escape }}</description>
  <language>{{ site.lang }}</language>
  {%- assign eps = site.episodes | sort: "date" | reverse -%}
  {%- for ep in eps limit: 30 %}
  <item>
    <title>S{{ ep.season }} Day {{ ep.day }}: {{ ep.title | xml_escape }}</title>
    <link>{{ ep.url | absolute_url }}</link>
    <guid isPermaLink="true">{{ ep.url | absolute_url }}</guid>
    <pubDate>{{ ep.date | date_to_rfc822 }}</pubDate>
    <description>{% for line in ep.thread %}{{ line.text | xml_escape }} {% endfor %}</description>
  </item>
  {%- endfor %}
</channel>
</rss>
